# Auth.js v5 (next-auth@5)
AUTH_SECRET=replace-with-`openssl rand -hex 32`
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# Data store: 'memory' (default) or 'prisma'.
#   memory → in-memory adapters。process 再起動でデータ消失。
#   prisma → User entity が Postgres に永続化（β-5-a pilot）。他は memory のまま。
DATA_STORE=memory

# Prisma で使う Postgres 接続文字列。DATA_STORE=prisma の時のみ必須。
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meimeitei?schema=public
